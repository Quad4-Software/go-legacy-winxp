diff --git a/src/cmd/vendor/golang.org/x/sys/windows/zsyscall_windows.go b/src/cmd/vendor/golang.org/x/sys/windows/zsyscall_windows.go
index f25b7308..96044839 100644
--- a/src/cmd/vendor/golang.org/x/sys/windows/zsyscall_windows.go
+++ b/src/cmd/vendor/golang.org/x/sys/windows/zsyscall_windows.go
@@ -1759,6 +1759,9 @@ func CancelIo(s Handle) (err error) {
 }
 
 func CancelIoEx(s Handle, o *Overlapped) (err error) {
+	if err := procCancelIoEx.Find(); err != nil {
+		return CancelIo(s)
+	}
 	r1, _, e1 := syscall.SyscallN(procCancelIoEx.Addr(), uintptr(s), uintptr(unsafe.Pointer(o)))
 	if r1 == 0 {
 		err = errnoErr(e1)
@@ -1966,6 +1969,9 @@ func DeleteFile(path *uint16) (err error) {
 }
 
 func deleteProcThreadAttributeList(attrlist *ProcThreadAttributeList) {
+	if err := procDeleteProcThreadAttributeList.Find(); err != nil {
+		return
+	}
 	syscall.SyscallN(procDeleteProcThreadAttributeList.Addr(), uintptr(unsafe.Pointer(attrlist)))
 	return
 }
@@ -2779,6 +2785,13 @@ func getWindowsDirectory(dir *uint16, dirLen uint32) (len uint32, err error) {
 }
 
 func initializeProcThreadAttributeList(attrlist *ProcThreadAttributeList, attrcount uint32, flags uint32, size *uintptr) (err error) {
+	if err := procInitializeProcThreadAttributeList.Find(); err != nil {
+		if attrlist == nil && size != nil {
+			*size = 128
+			return ERROR_INSUFFICIENT_BUFFER
+		}
+		return nil
+	}
 	r1, _, e1 := syscall.SyscallN(procInitializeProcThreadAttributeList.Addr(), uintptr(unsafe.Pointer(attrlist)), uintptr(attrcount), uintptr(flags), uintptr(unsafe.Pointer(size)))
 	if r1 == 0 {
 		err = errnoErr(e1)
@@ -3492,6 +3505,9 @@ func UnmapViewOfFile(addr uintptr) (err error) {
 }
 
 func updateProcThreadAttribute(attrlist *ProcThreadAttributeList, flags uint32, attr uintptr, value unsafe.Pointer, size uintptr, prevvalue unsafe.Pointer, returnedsize *uintptr) (err error) {
+	if err := procUpdateProcThreadAttribute.Find(); err != nil {
+		return nil
+	}
 	r1, _, e1 := syscall.SyscallN(procUpdateProcThreadAttribute.Addr(), uintptr(unsafe.Pointer(attrlist)), uintptr(flags), uintptr(attr), uintptr(value), uintptr(size), uintptr(prevvalue), uintptr(unsafe.Pointer(returnedsize)))
 	if r1 == 0 {
 		err = errnoErr(e1)
diff --git a/src/runtime/netpoll_windows.go b/src/runtime/netpoll_windows.go
index db5d0435..f2c0ef84 100644
--- a/src/runtime/netpoll_windows.go
+++ b/src/runtime/netpoll_windows.go
@@ -187,21 +187,42 @@ func netpoll(delay int64) (gList, int32) {
 	} else {
 		wait = uint32(delay / 1e6)
 	}
-	n := len(entries) / int(gomaxprocs)
-	if n < 8 {
-		n = 8
-	}
 	if delay != 0 {
 		mp.blocked = true
 	}
-	if stdcall(_GetQueuedCompletionStatusEx, iocphandle, uintptr(unsafe.Pointer(&entries[0])), uintptr(n), uintptr(unsafe.Pointer(&n)), uintptr(wait), 0) == 0 {
-		mp.blocked = false
-		errno := getlasterror()
-		if errno == windows.WAIT_TIMEOUT {
-			return gList{}, 0
+	n := 0
+	if _GetQueuedCompletionStatusEx != nil {
+		nn := len(entries) / int(gomaxprocs)
+		if nn < 8 {
+			nn = 8
 		}
-		println("runtime: GetQueuedCompletionStatusEx failed (errno=", errno, ")")
-		throw("runtime: netpoll failed")
+		if stdcall(_GetQueuedCompletionStatusEx, iocphandle, uintptr(unsafe.Pointer(&entries[0])), uintptr(nn), uintptr(unsafe.Pointer(&n)), uintptr(wait), 0) == 0 {
+			mp.blocked = false
+			errno := getlasterror()
+			if errno == windows.WAIT_TIMEOUT {
+				return gList{}, 0
+			}
+			println("runtime: GetQueuedCompletionStatusEx failed (errno=", errno, ")")
+			throw("runtime: netpoll failed")
+		}
+	} else if _GetQueuedCompletionStatus != nil {
+		var bytes uint32
+		var key uintptr
+		var ov *windows.Overlapped
+		if stdcall(_GetQueuedCompletionStatus, iocphandle, uintptr(unsafe.Pointer(&bytes)), uintptr(unsafe.Pointer(&key)), uintptr(unsafe.Pointer(&ov)), uintptr(wait)) == 0 {
+			mp.blocked = false
+			errno := getlasterror()
+			if errno == windows.WAIT_TIMEOUT {
+				return gList{}, 0
+			}
+			println("runtime: GetQueuedCompletionStatus failed (errno=", errno, ")")
+			throw("runtime: netpoll failed")
+		}
+		entries[0] = overlappedEntry{key: key, ov: ov, qty: bytes}
+		n = 1
+	} else {
+		mp.blocked = false
+		throw("runtime: netpoll unsupported on this Windows version")
 	}
 	mp.blocked = false
 	delta := int32(0)
