From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: go-legacy-winxp <go-legacy-winxp@local>
Date: Sun, 14 Jun 2026 00:00:00 +0000
Subject: [PATCH] Add Windows XP support

---
 src/cmd/link/internal/ld/pe.go                     |  2 +-
 .../golang.org/x/sys/windows/zsyscall_windows.go | 16 ++++++++
 src/runtime/netpoll_windows.go                     | 43 ++++++++++++++++------
 src/runtime/os_windows.go                          | 31 ++++++++++------
 src/runtime/signal_windows.go                      | 14 +++++++
 src/syscall/zsyscall_windows.go                    | 16 ++++++++
 6 files changed, 98 insertions(+), 24 deletions(-)

diff --git a/src/cmd/link/internal/ld/pe.go b/src/cmd/link/internal/ld/pe.go
